# Corp Library configuration. Copy to .env and fill in. Never commit .env.

# ── General ───────────────────────────────────────────────────────────────────
APP_NAME=Corp Library
TZ=Europe/Madrid
# Hostname of the app (DNS A record pointing to the Linux server); served by Traefik on HTTPS
APP_HOST=corplibrary.dept.company.com

# App administrators (Windows usernames, comma-separated). Admins get the admin
# console; they see no more documents than Windows lets them open.
ADMIN_USERS=jlleongarcia

# ── Sessions ──────────────────────────────────────────────────────────────────
# People stay signed in while they use the app (sliding expiry)
SESSION_DAYS=30
# Group memberships are re-read from AD this often for signed-in users
GROUPS_REFRESH_HOURS=8

# ── Single sign-on (Kerberos) ─────────────────────────────────────────────────
# Keytab for the SPN HTTP/<APP_HOST>, from IT. Put it in ./secrets/ next to
# docker-compose.yml (mounted read-only at /secrets; must be readable by uid 10001).
# Empty = SSO off: everyone uses the sign-in form.
KERBEROS_KEYTAB=
# Realm in the tickets; empty = LDAP_DOMAIN in upper case
KERBEROS_REALM=

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change-me

# ── Active Directory (LDAP) ───────────────────────────────────────────────────
LDAP_SERVER=dc01.company.com
LDAP_PORT=636
LDAP_USE_SSL=true
# Internal CA that signed the domain controllers' certificates (PEM). Put the file in
# ./certs/ next to docker-compose.yml; it is mounted read-only at /certs. Empty = system CAs.
LDAP_CA_CERT_FILE=/certs/internal-ca.pem
LDAP_DOMAIN=company.com
LDAP_BASE_DN=DC=company,DC=com
LDAP_USER_SEARCH_BASE=
LDAP_USER_FILTER=(sAMAccountName={username})
# Read-only account for SID/group lookups (can be the scanner account). Also used to
# read the groups (tokenGroups) of SSO users and to refresh them for signed-in users.
LDAP_BIND_DN=svc-corplib-scan@company.com
LDAP_BIND_PASSWORD=

# ── File server (SMB) ─────────────────────────────────────────────────────────
# Read-only service account. Shares themselves are added in the admin UI.
SMB_USERNAME=svc-corplib-scan@company.com
SMB_PASSWORD=
SMB_AUTH_PROTOCOL=negotiate

# ── Scanner ───────────────────────────────────────────────────────────────────
# Local hour of the nightly scan (-1 disables it)
SCAN_HOUR=2
# Files larger than this get a quick hash only in the duplicates report
DEDUPE_FULL_HASH_MAX_SIZE=536870912

# ── Content extraction (search) ───────────────────────────────────────────────
# Bigger files are searchable by name and path only
EXTRACT_MAX_SIZE=52428800
# OCR of scanned PDFs (Tesseract is in the image)
OCR_ENABLED=true
OCR_LANGUAGES=spa+eng
OCR_MAX_PAGES=30

# ── Audit log ─────────────────────────────────────────────────────────────────
# Searches, views and downloads are kept this many days (0 = forever)
AUDIT_RETENTION_DAYS=365

# ── Backups ───────────────────────────────────────────────────────────────────
BACKUP_DIR=./backups
BACKUP_HOUR=1
BACKUP_KEEP_DAYS=14

# ── Development only ──────────────────────────────────────────────────────────
# Any username signs in without a password. Only works on a developer PC: refused
# when LDAP_SERVER or KERBEROS_KEYTAB is set, or the database isn't local.
DEV_MODE=false
# Fake groups for dev users, matched by name in .corplib-acl.json files
# (see README, "Testing permissions locally"). Example: alice:finance,hr;bob:hr
DEV_GROUPS=
