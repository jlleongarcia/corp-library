# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=Corp Library

# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-secret-key

ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Database ──────────────────────────────────────────────────────────────────
# Docker volume path (default). Change to an absolute path for local dev.
DATABASE_URL=sqlite:////app/data/corp_library.db

# ── LDAP / Active Directory ───────────────────────────────────────────────────
LDAP_SERVER=ldap.company.com
LDAP_PORT=389
LDAP_USE_SSL=false
LDAP_DOMAIN=company.com
LDAP_BASE_DN=DC=company,DC=com
LDAP_BIND_DN=CN=svc-corplibrary,OU=ServiceAccounts,DC=company,DC=com
LDAP_BIND_PASSWORD=your-service-account-password
LDAP_USER_SEARCH_BASE=OU=Users,DC=company,DC=com
LDAP_USER_FILTER=(sAMAccountName={username})
LDAP_GROUP_ATTRIBUTE=memberOf

# ── Dev mode ──────────────────────────────────────────────────────────────────
# Set DEV_MODE=true to bypass LDAP and use the local admin account below.
# NEVER leave DEV_MODE=true in production.
DEV_MODE=true
DEV_ADMIN_USERNAME=admin
DEV_ADMIN_PASSWORD=admin123

# ── Scanner ───────────────────────────────────────────────────────────────────
SCAN_INTERVAL_HOURS=6
